{
  "_comment": "Scenario profiles for matrix.py: prs = parallel PRs, params override team.py DEFAULTS. quick = part of the fast set (--quick, used in CI). legacy_ref = simulate the agent tooling of that commit instead (its merge gate if it predates the queue). expect = outcomes other than merged that are correct for this profile.",
  "baseline": {
    "prs": 4,
    "params": {},
    "quick": true
  },
  "8 parallel PRs": {
    "prs": 8,
    "params": {}
  },
  "12 parallel PRs": {
    "prs": 12,
    "params": {
      "conflict": 0.2
    }
  },
  "heavy conflicts": {
    "prs": 6,
    "params": {
      "conflict": 0.7
    },
    "quick": true
  },
  "conflicts, no review skip": {
    "prs": 5,
    "params": {
      "conflict": 0.5,
      "skip_same": false
    }
  },
  "flaky CI": {
    "prs": 5,
    "params": {
      "ci_fail": 0.3,
      "ci_hang": 0.1,
      "ci_slow": 0.4
    },
    "quick": true
